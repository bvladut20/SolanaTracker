<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.14" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.14" PrivateAssets="all" />
    <ProjectReference Include="../SolanaTracker.Application/SolanaTracker.Application.csproj" />
    <ProjectReference Include="../SolanaTracker.Infrastructure/SolanaTracker.Infrastructure.csproj" />
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Update="appsettings.local.json" CopyToOutputDirectory="Always" CopyToPublishDirectory="Never" />
  </ItemGroup>
</Project>
